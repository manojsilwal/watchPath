NODE_ENV=development
PORT=9000

# --- API (apps/api) — copy to repo root `.env` or run with env vars ---
# docker-compose maps host 5433 → container 5432
DATABASE_URL=postgresql://watchpath:watchpath@127.0.0.1:5433/watchpath
# Set SKIP_DB_MIGRATE=true only if you run migrations separately (`npm run db:migrate -w apps/api`).
# SKIP_DB_MIGRATE=true

# HS256 secret for API session JWT (min 16 chars). Used after Firebase exchange.
JWT_SECRET=change-me-to-a-long-random-string-at-least-16
# Optional JWT lifetime for /api/auth/exchange (default 12h)
# JWT_EXPIRES_IN=12h

# Comma-separated Google account emails allowed to use admin + /api/auth/exchange
ADMIN_EMAILS=you@gmail.com

# Firebase Admin SDK — pick ONE approach:
# 1) Service account JSON as a single line (recommended for Render etc.)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# 2) Application Default Credentials (local): `gcloud auth application-default login` then omit JSON.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Ingest new pending verification rows (pipeline / scripts)
# INGEST_API_KEY=long-random-secret

GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

TMDB_API_KEY=replace_me
WATCHMODE_API_KEY=replace_me
YOUTUBE_API_KEY=replace_me

FIRESTORE_DATABASE_ID=(default)

# --- Web (apps/web) — use apps/web/.env.local for Next.js ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:9000
NEXT_PUBLIC_FIREBASE_API_KEY=replace_me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace_me
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace_me

# Note: a shell `GOOGLE_API_KEY` (e.g. in ~/.zshrc) is usually for Maps / Gemini / other Google Cloud APIs.
# Firebase Web uses NEXT_PUBLIC_FIREBASE_API_KEY from the Firebase console (Project settings).
