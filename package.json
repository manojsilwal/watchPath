{
  "name": "watchpath-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/web\" \"npm run dev -w apps/api\"",
    "build": "npm run build --workspaces --if-present",
    "tunnel:web": "cloudflared tunnel --url http://127.0.0.1:4000",
    "tunnel:api": "cloudflared tunnel --url http://127.0.0.1:9000"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "concurrently": "^9.2.1"
  }
}
