# watchPath Production environment variables for GCP VM Deployment
# (Copy these from your local .env or .env.example)

NODE_ENV=production
PORT=9000
DATABASE_URL=postgresql://watchpath:watchpath@postgres:5432/watchpath

# API Secrets
JWT_SECRET=your_secure_jwt_secret_here
ADMIN_EMAILS=your_admin_email@gmail.com
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# External APIs
TMDB_API_KEY=your_tmdb_key
WATCHMODE_API_KEY=your_watchmode_key
YOUTUBE_API_KEY=your_youtube_key
FIRESTORE_DATABASE_ID=(default)

# Web Frontend Config
NEXT_PUBLIC_API_BASE_URL=http://<YOUR_GCP_VM_IP>:9000
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
